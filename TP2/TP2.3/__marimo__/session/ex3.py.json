</span><span class=\"n\">anima\u00e7\u00e3o</span><span class=\"w\"> </span><span class=\"n\">que</span><span class=\"w\"> </span><span class=\"n\">exprime</span><span class=\"w\"> </span><span class=\"n\">que</span><span class=\"w\"> </span><span class=\"n\">o</span><span class=\"w\"> </span><span class=\"n\">programa</span><span class=\"w\"> </span><span class=\"n\">termina</span><span class=\"w\"> </span><span class=\"n\">quaisquer</span><span class=\"w\"> </span><span class=\"n\">que</span><span class=\"w\"> </span><span class=\"n\">sejam</span><span class=\"w\"> </span><span class=\"n\">os</span><span class=\"w\"> </span><span class=\"n\">valores</span><span class=\"w\"> </span><span class=\"n\">iniciais</span><span class=\"w\"> </span><span class=\"n\">de</span><span class=\"w\"> </span><span class=\"n\">$$</span><span class=\"err\">\\</span><span class=\"p\">,</span><span class=\"n\">a</span><span class=\"err\">\\</span><span class=\"p\">,</span><span class=\"n\">$$</span><span class=\"w\"> </span><span class=\"n\">e</span><span class=\"w\"> </span><span class=\"n\">$$</span><span class=\"err\">\\</span><span class=\"p\">,</span><span class=\"n\">b</span><span class=\"err\">\\</span><span class=\"p\">,</span><span class=\"n\">$$</span><span class=\"w\"> </span><span class=\"n\">e</span><span class=\"w\"> </span><span class=\"n\">prove</span><span class=\"w\"> </span><span class=\"n\">que</span><span class=\"w\"> </span><span class=\"n\">ela</span><span class=\"w\"> </span><span class=\"n\">se</span><span class=\"w\"> </span><span class=\"n\">verifica</span><span class=\"w\"> </span><span class=\"k\">no</span><span class=\"w\"> </span><span class=\"n\">SFOTS</span><span class=\"w\">  </span><span class=\"n\">que</span><span class=\"w\"> </span><span class=\"n\">construiu</span><span class=\"p\">.</span>\n</code></pre></div></span>"
